Mapping: SACTRegimenToFHIR
Source: SACTRegimen
Target: "http://hl7.org/fhir/R4"
Id: sact-regimen-to-fhir
Title: "SACT Regimen to FHIR"
Description: "Mapping of the SACT Regimen logical model to the FHIR profiles of this guide (PlanDefinition: SACT Regimen and ActivityDefinition: SACT Administration)."
* -> "PlanDefinition (PlanDefinitionSactRegimenEu)"
* identifier -> "PlanDefinition.identifier"
* name -> "PlanDefinition.title"
* acronym -> "PlanDefinition.subtitle"
* synonym -> "Not mapped in this version (see Known Issues)"
* version -> "PlanDefinition.version"
* status -> "PlanDefinition.status"
* description -> "PlanDefinition.description"
* therapyType -> "PlanDefinition.topic"
* indication -> "PlanDefinition.extension[indication] (SactRegimenIndication); cancer condition also replicated in PlanDefinition.useContext (code = focus)"
* indication.cancerCondition -> "PlanDefinition.extension[indication].extension[cancerCondition]"
* indication.histology -> "PlanDefinition.extension[indication].extension[histology]"
* indication.stage -> "PlanDefinition.extension[indication].extension[stage]"
* indication.biomarker -> "PlanDefinition.extension[indication].extension[biomarker]"
* indication.intent -> "PlanDefinition.extension[indication].extension[intent]"
* indication.setting -> "PlanDefinition.extension[indication].extension[setting]"
* indication.lineOfTherapy -> "PlanDefinition.extension[indication].extension[lineOfTherapy]"
* indication.eligibilityNotes -> "PlanDefinition.extension[indication].extension[eligibilityNotes]"
* emetogenicRisk -> "PlanDefinition.extension[emetogenicRisk]"
* cycle -> "PlanDefinition.action[cycle]"
* cycle.name -> "PlanDefinition.action[cycle].title"
* cycle.cycleLength -> "PlanDefinition.action[cycle].timingTiming.repeat.period / periodUnit"
* cycle.numberOfCycles -> "PlanDefinition.action[cycle].timingTiming.repeat.count"
* cycle.maxNumberOfCycles -> "PlanDefinition.action[cycle].timingTiming.repeat.countMax"
* cycle.untilProgression -> "PlanDefinition.action[cycle].description"
* cycle.component -> "PlanDefinition.action[cycle].action + ActivityDefinition (ActivityDefinitionSactAdministrationEu) referenced by definitionCanonical"
* cycle.component.sequence -> "Order of PlanDefinition.action[cycle].action and relatedAction"
* cycle.component.role -> "PlanDefinition.action[cycle].action.code"
* cycle.component.agent -> "ActivityDefinition.productCodeableConcept"
* cycle.component.dose -> "ActivityDefinition.dosage.doseAndRate.doseQuantity"
* cycle.component.maxDose -> "ActivityDefinition.dosage.maxDosePerAdministration"
* cycle.component.route -> "ActivityDefinition.dosage.route"
* cycle.component.administrationMethod -> "ActivityDefinition.dosage.method"
* cycle.component.administrationDays -> "PlanDefinition.action[cycle].action.timingRange (one action per contiguous range of days)"
* cycle.component.infusionDuration -> "ActivityDefinition.dosage.timing.repeat.duration / durationUnit"
* cycle.component.timingRelation -> "PlanDefinition.action[cycle].action.relatedAction"
* cycle.component.diluent -> "ActivityDefinition.dosage.text"
* cycle.component.optional -> "PlanDefinition.action[cycle].action.requiredBehavior = could"
* cycle.component.instructions -> "ActivityDefinition.dosage.additionalInstruction / dosage.text"
* monitoring -> "PlanDefinition.action[monitoring]"
* monitoring.test -> "PlanDefinition.action[monitoring].input.codeFilter.code"
* monitoring.timing -> "PlanDefinition.action[monitoring].description"
* monitoring.threshold -> "PlanDefinition.action[monitoring].description"
* doseModification -> "PlanDefinition.action[doseModification]"
* doseModification.trigger -> "PlanDefinition.action[doseModification].reason"
* doseModification.grade -> "PlanDefinition.action[doseModification].description"
* doseModification.affectedAgent -> "PlanDefinition.action[doseModification].description"
* doseModification.action -> "PlanDefinition.action[doseModification].description"
* doseModification.reductionPercentage -> "PlanDefinition.action[doseModification].description"
* doseModification.description -> "PlanDefinition.action[doseModification].description"
* evidence -> "PlanDefinition.relatedArtifact"
* jurisdiction -> "PlanDefinition.jurisdiction"
* lastReviewDate -> "PlanDefinition.lastReviewDate"
* author -> "PlanDefinition.author"
* notes -> "PlanDefinition.usage"

Mapping: SACTRegimenCatalogToFHIR
Source: SACTRegimenCatalog
Target: "http://hl7.org/fhir/R4"
Id: sact-catalog-to-fhir
Title: "SACT Regimen Catalog to FHIR"
Description: "Mapping of the SACT Regimen Catalog logical model to the 'Library: SACT Regimen Catalog' profile."
* -> "Library (LibrarySactCatalogEu)"
* identifier -> "Library.identifier"
* title -> "Library.title"
* version -> "Library.version"
* status -> "Library.status"
* date -> "Library.date"
* publisher -> "Library.publisher"
* jurisdiction -> "Library.jurisdiction"
* description -> "Library.description"
* regimen -> "Library.relatedArtifact[regimen].resource"
